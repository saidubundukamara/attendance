# Copy to .env.local and fill in.

# SQLite file. The folder is created on first run.
DATABASE_PATH=./data/attendance.db

# Base URL encoded into every QR code. Must be reachable from students' phones.
APP_URL=http://localhost:3000

# Lecturer login.
LECTURER_PASSWORD=
# Signs the lecturer session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Signs QR tokens and check-in passes. Generate with: openssl rand -base64 32
QR_SECRET=

# Google Sheets (service account shared on the spreadsheet as Editor).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
