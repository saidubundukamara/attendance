# Copy to .env.local and fill in.

# Database. Leave the two TURSO values empty to use a local SQLite file
# (fine for development). Set them to use Turso, which is required on Vercel
# and any other host without a persistent disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local SQLite file, used only when TURSO_DATABASE_URL is empty.
DATABASE_PATH=./data/attendance.db

# Base URL encoded into every QR code and used for the Google sign-in
# redirect. Must be reachable from students' phones.
APP_URL=http://localhost:3000

# Signs the lecturer session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Signs QR tokens and check-in passes. Generate with: openssl rand -base64 32
QR_SECRET=
# Encrypts lecturers' stored Google refresh tokens. 32 bytes, base64:
# openssl rand -base64 32. Don't change it once lecturers have signed in.
TOKEN_ENCRYPTION_KEY=

# Admins (comma-separated Google emails). They can always sign in, approve
# other lecturers and manage cohorts at /admin.
ADMIN_EMAILS=

# Google sign-in. See "Google setup" in the README. A "Web application"
# OAuth client with APP_URL/auth/google/callback as a redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Picker, for lecturers to pick their attendance sheet. The app id is
# the Cloud project NUMBER.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Only when upgrading from the single-lecturer version: its submissions
# folder, handed to the first admin who signs in. Remove afterwards.
GOOGLE_DRIVE_FOLDER_ID=

# Time zone deadlines are entered and shown in.
APP_TIMEZONE=Africa/Freetown
